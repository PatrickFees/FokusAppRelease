@using FokusApp.Core.Models
@using FokusApp.Core.Enums
@using FokusApp.Components.TaskOverViewComponent
@using FokusApp.Components.SharedUI.TaskScheduleBadge

<li @key="Task.Id"
    class="task-item @PriorityFormatter.GetCssClass(Task.Priority) @(_areActionsVisible ? "show-actions" : string.Empty) @(IsPast ? "is-past" : string.Empty) @(_isLeaving ? "is-leaving" : string.Empty)"
    @onpointerdown="HandlePointerDown"
    @onpointerup="HandlePointerUp"
    @onpointerleave="ResetSwipeTracking"
    @onpointercancel="ResetSwipeTracking">
    <div class="task-swipe-hint">&lt;</div>
    <div class="task-item-content" @onclick="HideActions">
        <div class="task-item-header">
            <span class="task-priority priority-label @PriorityFormatter.GetCssClass(Task.Priority)">@Localizer["Priority", PriorityFormatter.Format(Task.Priority)]</span>
        </div>
        <p class="task-description">@Task.Note</p>
        <div class="task-meta">
            <span class="task-due-date">@GetTaskDateLabel(Task, ListType)</span>
            <TaskScheduleBadge Task="Task" />
            @if (!string.IsNullOrWhiteSpace(TaskStatusLabel))
            {
                <span class="task-estimate">@Localizer["Status", TaskStatusLabel]</span>
            }
        </div>
        @if (IsPast && !IsRunning)
        {
            <div class="task-assign-chips"
                 role="group"
                 aria-label="@Localizer["AssignTask"]"
                 @onpointerdown:stopPropagation="true"
                 @onpointerup:stopPropagation="true"
                 @onclick:stopPropagation="true">
                <button type="button" class="task-assign-chip" @onclick="() => AssignAsync(PastTaskTarget.Today)">@Localizer["AssignToday"]</button>
                <button type="button" class="task-assign-chip" @onclick="() => AssignAsync(PastTaskTarget.Tomorrow)">@Localizer["AssignTomorrow"]</button>
                <button type="button" class="task-assign-chip" @onclick="HandleRescheduleAsync">@Localizer["AssignOtherDay"]</button>
                <button type="button" class="task-assign-chip discard" @onclick="DiscardAsync">@Localizer["AssignDiscard"]</button>
            </div>
        }
    </div>
    <div class="task-item-actions">
        @if (IsRunning)
        {
            <button type="button" class="task-action running" disabled>
                @Localizer["TaskCurrentlyRunning"]
            </button>
        }
        else
        {
            <button type="button"
                    class="task-action delete"
                    title="@Localizer["Delete"]"
                    aria-label="@Localizer["Delete"]"
                    @onclick:stopPropagation="true"
                    @onclick="HandleDeleteAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M4 7h16M9 7V4.5h6V7M6.5 7l1 13h9l1-13M10 11v6M14 11v6" />
                </svg>
            </button>
            <button type="button"
                    class="task-action edit"
                    title="@Localizer["Edit"]"
                    aria-label="@Localizer["Edit"]"
                    @onclick:stopPropagation="true"
                    @onclick="HandleEditAsync">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M4 20l1-4L16.5 4.5a2 2 0 0 1 3 0l0 0a2 2 0 0 1 0 3L8 19l-4 1zM14.5 6.5l3 3" />
                </svg>
            </button>
        }
    </div>
</li>

@code {
    private const double SwipeThreshold = 45;

    private double? _swipeStartX;
    private const int LeaveAnimationMilliseconds = 220;

    private bool _areActionsVisible;
    private bool _isLeaving;

    public enum TaskListItemType
    {
        Active,
        Template,
        Overdue,
        Completed
    }

    [Parameter, EditorRequired]
    public TaskDto Task { get; set; } = null!;

    [Parameter, EditorRequired]
    public TaskListItemType ListType { get; set; }

    [Parameter]
    public bool IsRunning { get; set; }

    [Parameter]
    public EventCallback<Guid> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

    [Parameter]
    public EventCallback<Guid> OnReschedule { get; set; }

    [Parameter]
    public EventCallback<(Guid TaskId, PastTaskTarget Target)> OnAssign { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDiscard { get; set; }

    private bool IsPast => ListType == TaskListItemType.Overdue;

    private string TaskStatusLabel => GetTaskStatusLabel(Task, ListType);

    private string GetTaskDateLabel(TaskDto task, TaskListItemType taskListType) => taskListType switch
    {
        TaskListItemType.Active or TaskListItemType.Overdue => Localizer["CreatedOn", task.CreationDate],
        TaskListItemType.Template => Localizer["TemplateWithoutDate"],
        TaskListItemType.Completed => Localizer["CompletedOn", task.CreationDate],
        _ => string.Empty
    };

    private string GetTaskStatusLabel(TaskDto task, TaskListItemType taskListType) => taskListType switch
    {
        TaskListItemType.Active or TaskListItemType.Overdue => IsRunning ? Localizer["Active"] : Localizer["Open"],
        TaskListItemType.Template => Localizer["Template"],
        _ => string.Empty
    };

    private void HandlePointerDown(PointerEventArgs args)
    {
        _swipeStartX = args.ClientX;
    }

    private void HandlePointerUp(PointerEventArgs args)
    {
        if (_swipeStartX.HasValue)
        {
            var swipeDelta = args.ClientX - _swipeStartX.Value;
            _areActionsVisible = swipeDelta switch
            {
                <= -SwipeThreshold => true,
                >= SwipeThreshold => false,
                _ => _areActionsVisible
            };
        }

        ResetSwipeTracking();
    }

    private void HideActions()
    {
        _areActionsVisible = false;
    }

    private async Task AssignAsync(PastTaskTarget target)
    {
        if (Task.Id is Guid taskId)
        {
            await PlayLeaveAnimationAsync();
            await OnAssign.InvokeAsync((taskId, target));
        }
    }

    private async Task DiscardAsync()
    {
        if (Task.Id is Guid taskId)
        {
            await PlayLeaveAnimationAsync();
            await OnDiscard.InvokeAsync(taskId);
        }
    }

    private async Task PlayLeaveAnimationAsync()
    {
        _isLeaving = true;
        StateHasChanged();
        await System.Threading.Tasks.Task.Delay(LeaveAnimationMilliseconds);
    }

    private async Task HandleEditAsync()
    {
        HideActions();
        if (Task.Id is Guid taskId)
        {
            await OnEdit.InvokeAsync(taskId);
        }
    }

    private async Task HandleRescheduleAsync()
    {
        HideActions();
        if (Task.Id is Guid taskId)
        {
            await OnReschedule.InvokeAsync(taskId);
        }
    }

    private async Task HandleDeleteAsync()
    {
        HideActions();
        if (Task.Id is Guid taskId)
        {
            await OnDelete.InvokeAsync(taskId);
        }
    }

    private void ResetSwipeTracking()
    {
        _swipeStartX = null;
    }
}
