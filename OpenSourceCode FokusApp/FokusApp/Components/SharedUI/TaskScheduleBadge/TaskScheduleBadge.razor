@using FokusApp.Core.Enums
@using FokusApp.Core.Models

@if (Task.TaskTime is { } time)
{
    var label = $"{time.Hours:00}:{time.Minutes:00}";
    <span class="task-schedule-time" aria-label="@Localizer["TaskTimeAria", label]">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
        </svg>
        @label
    </span>
}

@if (Task.RepeatUnit != TaskRepeatUnit.None || Task.SeriesId.HasValue)
{
    <span class="task-schedule-repeat" role="img" aria-label="@Localizer["RepeatingTask"]" title="@Localizer["RepeatingTask"]">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3" />
        </svg>
    </span>
}

@code {
    [Parameter, EditorRequired]
    public TaskDto Task { get; set; } = null!;
}
