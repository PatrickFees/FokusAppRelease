@page "/dein-tag"
@page "/calender"
@page "/"
@inherits ObservableComponentBase
@using System.Globalization
@using FokusApp.Components.Calender
@using FokusApp.Components.PopUps.TaskEdit
@using FokusApp.Components.PopUps.TaskSeriesChoice
@using FokusApp.Components.ToDoBook
@using Microsoft.AspNetCore.Components.Web
@inject FokusApp.Components.YourDay.IYourDayViewModel ViewModel
@inject NavigationManager NavigationManager
@inject FokusApp.Services.IUiBackPressService UiBackPressService

<PageTitle>@Localizer["YourDay"]</PageTitle>

<div class="your-day-page">
    <section class="your-day-shell" aria-label="@Localizer["YourDay"]">
        <header class="your-day-header">
            <button type="button"
                    class="your-day-nav-button"
                    aria-label="@Localizer["PreviousMonth"]"
                    @onclick="GoToPrevious">
                &#x2039;
            </button>
            <h2 class="your-day-month-title">@ViewModel.VisibleMonth.ToString("Y", CultureInfo.CurrentCulture)</h2>
            <button type="button"
                    class="your-day-nav-button"
                    aria-label="@Localizer["NextMonth"]"
                    @onclick="GoToNext">
                &#x203A;
            </button>
            <button type="button" class="your-day-today-button" @onclick="ViewModel.GoToToday">@Localizer["Today"]</button>
        </header>

        <CalenderMonthGrid Weeks="ViewModel.Weeks"
                           IsWeekCollapsed="IsCollapsedAway"
                           DayCssBuilder="BuildDayCss"
                           OnDayClick="HandleDayClick"
                           OnDayDoubleClick="HandleDayDoubleClick"
                           OnDayPointerDown="HandleDayPointerDown"
                           OnDayPointerUp="HandleDayPointerUp"
                           OnPointerLeave="ResetGestureTracking"
                           OnPointerCancel="ResetGestureTracking" />

        <div class="your-day-divider">
            <button type="button"
                    class="your-day-collapse-toggle"
                    aria-label="@(ViewModel.IsCalendarCollapsed ? Localizer["ExpandCalendar"] : Localizer["CollapseCalendar"])"
                    aria-expanded="@(ViewModel.IsCalendarCollapsed ? "false" : "true")"
                    @onclick="ViewModel.ToggleCalendarCollapsed">
                <span class="your-day-collapse-icon @(ViewModel.IsCalendarCollapsed ? "is-collapsed" : string.Empty)" aria-hidden="true"></span>
            </button>
        </div>

        <div class="your-day-day-list"
             data-onboarding="your-day-list"
             @onpointerdown="HandleListPointerDown"
             @onpointerup="HandleListPointerUp"
             @onpointercancel="ResetListGesture">
            @if (ViewModel.PastTaskCount > 0)
            {
                <button type="button" class="your-day-past-hint" @onclick="ViewModel.OpenPastTasks">
                    @(ViewModel.PastTaskCount == 1 ? Localizer["PastTasksHintOne"] : Localizer["PastTasksHintMany", ViewModel.PastTaskCount])
                </button>
            }
            <h3 class="your-day-day-list-title">@ViewModel.SelectedDay.ToString("D", CultureInfo.CurrentCulture)</h3>

            <ToDoBookTaskList Title="@Localizer["TaskTypeForYou"]"
                              AddButtonAriaLabel="@Localizer["AddForYouTask"]"
                              Tasks="ViewModel.ForYouTasks"
                              OnAdd="OpenAddPositiveTask"
                              JustCompletedTaskId="ViewModel.RecentlyCompletedTaskId"
                              OnTaskClick="HandleTaskClick" />

            <ToDoBookTaskList Title="@Localizer["TaskTypeToDo"]"
                              AddButtonAriaLabel="@Localizer["AddToDoTask"]"
                              Tasks="ViewModel.ToDoTasks"
                              OnAdd="OpenAddToDoTask"
                              JustCompletedTaskId="ViewModel.RecentlyCompletedTaskId"
                              OnTaskClick="HandleTaskClick" />
        </div>
    </section>
</div>

<ToDoBookActionPopup IsOpen="ViewModel.IsTaskActionPopupOpen"
                     PrimaryActionText="@PrimaryActionText"
                     CanStart="ViewModel.CanStartSelectedTask"
                     CanComplete="ViewModel.CanCompleteSelectedTask"
                     CanDelete="ViewModel.CanDeleteSelectedTask"
                     OnClose="ViewModel.CloseTaskActionPopup"
                     OnStart="StartSelectedTaskAsync"
                     OnComplete="ViewModel.MarkSelectedTaskAsDoneAsync"
                     OnDelete="ViewModel.DeleteSelectedTaskAsync"
                     OnEdit="OpenEditFromActionPopup" />

<TaskSeriesChoicePopUp IsOpen="ViewModel.IsSeriesChoiceOpen"
                        SeriesAction="ViewModel.PendingSeriesAction"
                        OnChoose="ViewModel.ChooseSeriesScopeAsync"
                        OnCancel="ViewModel.CancelSeriesChoice" />

<TaskEditPopUp @key="ViewModel.TaskEditorInput"
               IsOpen="ViewModel.IsTaskEditorOpen"
               Model="ViewModel.TaskEditorInput"
               OnClose="ViewModel.HandleTaskEditPopupCloseAsync" />

@code {
    private const int LongPressDurationMilliseconds = 450;
    private const double LongPressMoveTolerance = 12;
    private const double SwipeThreshold = 45;

    private DateTime? _pressedDate;
    private DateTime? _pressStartedAt;
    private double _pressStartX;
    private double _pressStartY;
    private bool _suppressNextClick;
    private double? _listStartX;
    private double? _listStartY;
    private bool _suppressTaskClick;
    private IDisposable? _backPressRegistration;

    private string PrimaryActionText => ViewModel.IsSelectedActionTaskActive
        ? Localizer["TimerRunning"]
        : Localizer["StartTask"];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _backPressRegistration = UiBackPressService.RegisterHandler(HandleBackPressed);
        Observe(ViewModel);
        await ViewModel.InitializeAsync();
    }

    private bool HandleBackPressed()
    {
        if (ViewModel.IsSeriesChoiceOpen)
        {
            ViewModel.CancelSeriesChoice();
            _ = InvokeAsync(StateHasChanged);
            return true;
        }

        if (ViewModel.IsTaskActionPopupOpen)
        {
            ViewModel.CloseTaskActionPopup();
            _ = InvokeAsync(StateHasChanged);
            return true;
        }

        return false;
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            _backPressRegistration?.Dispose();
        }

        base.Dispose(disposing);
    }

    private bool IsCollapsedAway(CalenderWeekModel week)
    {
        return ViewModel.IsCalendarCollapsed && !week.Days.Any(day => day.IsSelected);
    }

    private string BuildDayCss(CalenderDayCellModel day)
    {
        var classes = "calender-day";

        if (!day.IsInCurrentMonth && !ViewModel.IsCalendarCollapsed)
        {
            classes += " outside-month";
        }

        if (day.IsToday)
        {
            classes += " is-today";
        }

        if (day.IsSelected)
        {
            classes += " is-selected";
        }

        return classes;
    }

    private void GoToPrevious()
    {
        if (ViewModel.IsCalendarCollapsed)
        {
            ViewModel.MoveSelectedDay(forwards: false);
            return;
        }

        ViewModel.GoToPreviousMonth();
    }

    private void GoToNext()
    {
        if (ViewModel.IsCalendarCollapsed)
        {
            ViewModel.MoveSelectedDay(forwards: true);
            return;
        }

        ViewModel.GoToNextMonth();
    }

    private void HandleTaskClick(Guid taskId)
    {
        if (_suppressTaskClick)
        {
            _suppressTaskClick = false;
            return;
        }

        ViewModel.OpenTaskActionPopup(taskId);
    }

    private void HandleListPointerDown(PointerEventArgs args)
    {
        _suppressTaskClick = false;

        if (IsAnyModalOpen() || !ViewModel.IsCalendarCollapsed)
        {
            ResetListGesture();
            return;
        }

        _listStartX = args.ClientX;
        _listStartY = args.ClientY;
    }

    private void HandleListPointerUp(PointerEventArgs args)
    {
        if (!_listStartX.HasValue || !_listStartY.HasValue || IsAnyModalOpen() || !ViewModel.IsCalendarCollapsed)
        {
            ResetListGesture();
            return;
        }

        var deltaX = args.ClientX - _listStartX.Value;
        var deltaY = args.ClientY - _listStartY.Value;
        ResetListGesture();

        if (Math.Abs(deltaX) < SwipeThreshold || Math.Abs(deltaX) <= Math.Abs(deltaY))
        {
            return;
        }

        _suppressTaskClick = true;
        ViewModel.MoveSelectedDay(forwards: deltaX < 0);
    }

    private void ResetListGesture()
    {
        _listStartX = null;
        _listStartY = null;
    }

    private void OpenAddPositiveTask()
    {
        ViewModel.OpenTaskEditorForNewTask(isPositive: true);
    }

    private void OpenAddToDoTask()
    {
        ViewModel.OpenTaskEditorForNewTask(isPositive: false);
    }

    private void HandleDayClick(DateTime date)
    {
        if (_suppressNextClick)
        {
            _suppressNextClick = false;
            return;
        }

        ViewModel.SelectDay(date);
    }

    private void HandleDayDoubleClick(DateTime date)
    {
        if (IsAnyModalOpen())
        {
            return;
        }

        ViewModel.OpenTaskEditorForNewTask(date);
    }

    private void HandleDayPointerDown(CalenderMonthGrid.DayPointerEventArgs e)
    {
        if (IsAnyModalOpen())
        {
            return;
        }

        _suppressNextClick = false;
        _pressedDate = e.Date;
        _pressStartedAt = DateTime.UtcNow;
        _pressStartX = e.Pointer.ClientX;
        _pressStartY = e.Pointer.ClientY;
    }

    private void HandleDayPointerUp(CalenderMonthGrid.DayPointerEventArgs e)
    {
        var date = e.Date;
        var args = e.Pointer;

        if (!_pressedDate.HasValue || !_pressStartedAt.HasValue || _pressedDate.Value != date || IsAnyModalOpen())
        {
            ResetGestureTracking();
            return;
        }

        var duration = DateTime.UtcNow - _pressStartedAt.Value;
        var deltaX = args.ClientX - _pressStartX;
        var deltaY = args.ClientY - _pressStartY;
        var isWithinTolerance = Math.Abs(deltaX) <= LongPressMoveTolerance && Math.Abs(deltaY) <= LongPressMoveTolerance;
        var isHorizontalSwipe = Math.Abs(deltaX) >= SwipeThreshold && Math.Abs(deltaX) > Math.Abs(deltaY);

        ResetGestureTracking();

        if (isHorizontalSwipe)
        {
            _suppressNextClick = true;
            if (deltaX < 0)
            {
                GoToNext();
            }
            else
            {
                GoToPrevious();
            }

            return;
        }

        if (isWithinTolerance && duration.TotalMilliseconds >= LongPressDurationMilliseconds)
        {
            _suppressNextClick = true;
            ViewModel.OpenTaskEditorForNewTask(date);
        }
    }

    private void ResetGestureTracking()
    {
        _pressedDate = null;
        _pressStartedAt = null;
    }

    private bool IsAnyModalOpen()
    {
        return ViewModel.IsTaskEditorOpen || ViewModel.IsTaskActionPopupOpen || ViewModel.IsSeriesChoiceOpen;
    }

    private void OpenEditFromActionPopup()
    {
        if (ViewModel.IsSelectedActionTaskActive)
        {
            ViewModel.CloseTaskActionPopup();
            NavigationManager.NavigateTo("/focus-timer");
            return;
        }

        ViewModel.StartEditSelectedTask();
    }

    private async Task StartSelectedTaskAsync()
    {
        if (ViewModel.IsSelectedActionTaskActive)
        {
            ViewModel.CloseTaskActionPopup();
            NavigationManager.NavigateTo("/focus-timer");
            return;
        }

        if (await ViewModel.ExecutePrimarySelectedTaskActionAsync())
        {
            NavigationManager.NavigateTo("/focus-timer");
        }
    }
}
