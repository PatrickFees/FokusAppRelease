@implements IDisposable
<li class="suggestion-card @(_areActionsVisible ? "show-actions" : string.Empty) suggestions-item"
    data-suggestion-key="@Key"
    @onpointerdown="HandlePointerDown"
    @onpointerup="HandlePointerUp"
    @onpointerleave="ResetSwipeTracking"
    @onpointercancel="ResetSwipeTracking"
    @oncontextmenu:preventDefault="true">
    <div class="suggestion-swipe-hint">&lt;</div>
    <div class="suggestion-content" @onclick="HandleContentClick">
        <p class="suggestions-text">@Text</p>
    </div>
    <div class="suggestion-actions">
        <button type="button"
                class="suggestion-action delete suggestions-delete"
                title="@Localizer["Delete"]"
                aria-label="@Localizer["Delete"]"
                @onclick:stopPropagation="true"
                @onclick="HandleDeleteAsync">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4 7h16M9 7V4.5h6V7M6.5 7l1 13h9l1-13M10 11v6M14 11v6" />
            </svg>
        </button>
        <button type="button"
                class="suggestion-action edit suggestions-edit"
                title="@Localizer["Edit"]"
                aria-label="@Localizer["Edit"]"
                @onclick:stopPropagation="true"
                @onclick="HandleEditAsync">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4 20l1-4L16.5 4.5a2 2 0 0 1 3 0l0 0a2 2 0 0 1 0 3L8 19l-4 1zM14.5 6.5l3 3" />
            </svg>
        </button>
    </div>
</li>


@code {
    private const double SwipeThreshold = 45;

    private double? _swipeStartX;
    private bool _areActionsVisible;
    private bool _suppressNextClick;
    private CancellationTokenSource? _longPressCancellation;

    [Parameter]
    public int LongPressMilliseconds { get; set; } = 500;

    [Parameter, EditorRequired]
    public string Key { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> OnEdit { get; set; }

    [Parameter]
    public EventCallback<string> OnDelete { get; set; }

    private void HandlePointerDown(PointerEventArgs args)
    {
        _swipeStartX = args.ClientX;
        _suppressNextClick = false;
        StartLongPress();
    }

    private void StartLongPress()
    {
        CancelLongPress();
        var cancellation = new CancellationTokenSource();
        _longPressCancellation = cancellation;
        _ = ShowActionsAfterLongPressAsync(cancellation.Token);
    }

    private async Task ShowActionsAfterLongPressAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(LongPressMilliseconds, cancellationToken);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            _areActionsVisible = true;

            _suppressNextClick = true;
            StateHasChanged();
        });
    }

    private void CancelLongPress()
    {
        _longPressCancellation?.Cancel();
        _longPressCancellation?.Dispose();
        _longPressCancellation = null;
    }

    private void HandlePointerUp(PointerEventArgs args)
    {
        CancelLongPress();

        if (_swipeStartX.HasValue)
        {
            var swipeDelta = args.ClientX - _swipeStartX.Value;
            _areActionsVisible = swipeDelta switch
            {
                <= -SwipeThreshold => true,
                >= SwipeThreshold => false,
                _ => _areActionsVisible
            };
        }

        ResetSwipeTracking();
    }

    private void HideActions() => _areActionsVisible = false;

    private void HandleContentClick()
    {
        if (_suppressNextClick)
        {
            _suppressNextClick = false;
            return;
        }

        HideActions();
    }

    private async Task HandleEditAsync()
    {
        HideActions();
        await OnEdit.InvokeAsync(Key);
    }

    private async Task HandleDeleteAsync()
    {
        HideActions();
        await OnDelete.InvokeAsync(Key);
    }

    private void ResetSwipeTracking()
    {
        CancelLongPress();
        _swipeStartX = null;
    }

    public void Dispose() => CancelLongPress();
}
