@using FokusApp.Components.PopUps.Calendar
@using FokusApp.Components.PopUps.TaskEdit
@using FokusApp.Components.PopUps.TaskSchedule
@using FokusApp.Components.PopUps.TemplateList
@using FokusApp.Components.PopUps.TimeInputDialog
@using FokusApp.Components.SharedUI
@using FokusApp.Components.SharedUI.FilterComponent
@using FokusApp.Components.SharedUI.TaskDayButton
@using FokusApp.Core.Enums
@using Microsoft.AspNetCore.Components.Web
@inherits ObservableComponentBase
@inject ITaskEditPopUpViewModel ViewModel
@inject FokusApp.Services.IUiBackPressService UiBackPressService

@if (IsOpen)
{
<div class="modal-backdrop popup-overlay">
    <div class="modal-content"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@_dialogTitleId"
         tabindex="-1"
         @ref="_dialogElement"
         @onkeydown="HandleModalKeyDown">

        <div class="task-edit-header">
            <h2 id="@_dialogTitleId">@(ViewModel.IsUpdateMode ? Localizer["EditTask"] : Localizer["NewTask"])</h2>

            <button type="button"
                    class="schedule-button @(ViewModel.HasSchedule ? "has-schedule" : string.Empty)"
                    title="@Localizer["ScheduleButton"]"
                    aria-label="@Localizer["ScheduleButton"]"
                    @onclick="OpenSchedulePopup">
                <svg class="schedule-button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                </svg>
                @if (ViewModel.ScheduleTimeDisplay is { } scheduleTime)
                {
                    <span class="schedule-button-time">@scheduleTime</span>
                }
                @if (ViewModel.IsRepeating)
                {
                    <svg class="schedule-button-repeat" viewBox="0 0 24 24" aria-label="@Localizer["RepeatingTask"]" role="img" focusable="false">
                        <path d="M17 2l4 4-4 4M3 11V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 13v2a3 3 0 0 1-3 3H3" />
                    </svg>
                }
            </button>
        </div>

        <div class="template-task-toolbar">
            <span class="template-list-button-wrapper" @onclick="HighlightPositivityButtonsIfDisabled">
                <button type="button"
                        class="template-list-button"
                        disabled="@(!ViewModel.HasTemplateOptions)"
                        @onclick="OpenTemplateListPopup">
                    <span class="template-list-button-icon" aria-hidden="true"></span>
                    @Localizer["Templates"]
                </button>
            </span>

            <div class="form-check templateFlag-toggle">
                <input id="@_taskTemplateFlagInputId"
                        class="form-check-input"
                        type="checkbox"
                        checked="@ViewModel.Model.IsTemplate"
                        disabled="@ViewModel.IsTemplateLocked"
                        @onchange="OnTemplateFlagChanged" />
                <label class="form-check-label" for="@_taskTemplateFlagInputId">@Localizer["IsTemplate"]</label>
            </div>
        </div>

        <div class="form-group">
            <label for="@_taskNoteInputId">@Localizer["Task"]</label>
            <textarea id="@_taskNoteInputId"
                        class="form-control"
                        rows="4"
                        placeholder="@Localizer["DescribeTask"]"
                        @bind="ViewModel.Model.Note"></textarea>
        </div>

        <div class="form-group priority-selector">
            <div class="priority-selector-header">
            <span class="priority-badge @PriorityFormatter.GetCssClass(ViewModel.Model.Priority)">
                @Localizer["Priority", PriorityFormatter.Format(ViewModel.Model.Priority)]
                </span>
            </div>
            <input id="@_prioritySliderInputId"
                class="priority-slider @PriorityFormatter.GetCssClass(ViewModel.Model.Priority)"
                    type="range"
                    min="0"
                    max="@ViewModel.MaximumPriorityIndex"
                    step="1"
                    aria-label="@Localizer["Priority", PriorityFormatter.Format(ViewModel.Model.Priority)]"
                value="@ViewModel.SelectedPriorityIndex"
                    @oninput="OnPrioritySliderInput" />
        </div>

        <TaskTimerSelector Label="@Localizer["FocusTime"]"
                           Display="@ViewModel.FocusTimerDisplay"
                           DecreaseAriaLabel="@Localizer["DecreaseFocusTime"]"
                           IncreaseAriaLabel="@Localizer["IncreaseFocusTime"]"
                           ManualInputAriaLabel="@Localizer["SetFocusTimeManually"]"
                           OnDecrease="() => ViewModel.AdjustTimer(TimerType.FocusTimer, -ViewModel.TimerStepMinutes)"
                           OnIncrease="() => ViewModel.AdjustTimer(TimerType.FocusTimer, ViewModel.TimerStepMinutes)"
                           OnManualInput="() => OpenTimerInputDialog(TimerType.FocusTimer)" />

        <TaskTimerSelector Label="@Localizer["Break"]"
                           Display="@ViewModel.BreakTimerDisplay"
                           DecreaseAriaLabel="@Localizer["DecreaseBreakTime"]"
                           IncreaseAriaLabel="@Localizer["IncreaseBreakTime"]"
                           ManualInputAriaLabel="@Localizer["SetBreakTimeManually"]"
                           OnDecrease="() => ViewModel.AdjustTimer(TimerType.BreakTimer, -ViewModel.TimerStepMinutes)"
                           OnIncrease="() => ViewModel.AdjustTimer(TimerType.BreakTimer, ViewModel.TimerStepMinutes)"
                           OnManualInput="() => OpenTimerInputDialog(TimerType.BreakTimer)" />

        <div class="form-group positivity-selector">
            <label>@Localizer["TaskType"]</label>
            <div class="positivity-buttons">
                <button type="button"
                    class="positivity-button pill-button @(ViewModel.HasSelectedTaskPositivity && ViewModel.Model.IsPositive ? "selected" : string.Empty) @PositivityHighlightCssClass"
                    aria-pressed="@(ViewModel.HasSelectedTaskPositivity && ViewModel.Model.IsPositive)"
                        @onclick="() => ViewModel.SelectTaskPositivity(true)">
                    @Localizer["TaskTypeForYou"]
                </button>
                <button type="button"
                    class="positivity-button pill-button @(ViewModel.HasSelectedTaskPositivity && !ViewModel.Model.IsPositive ? "selected" : string.Empty) @PositivityHighlightCssClass"
                    aria-pressed="@(ViewModel.HasSelectedTaskPositivity && !ViewModel.Model.IsPositive)"
                        @onclick="() => ViewModel.SelectTaskPositivity(false)">
                    @Localizer["TaskTypeToDo"]
                </button>
            </div>
        </div>

    @if (ViewModel.IsTaskDateAllowed)
        {
            <div class="form-group">
                <TaskDayButton Model="@ViewModel.TaskDayButtonModel" OnClick="OpenTaskDatePopup" />
            </div>
        }

        <div class="modal-actions">
        <button class="popup-action-button popup-action-button--pill popup-action-button--primary" @onclick="HandleSaveAsync" disabled="@(!ViewModel.CanSave)"> @(ViewModel.IsUpdateMode ? Localizer["Update"] : Localizer["Save"]) </button>
      
                    
            <button class="popup-action-button popup-action-button--pill popup-action-button--secondary" @onclick="HandleCancelAsync">@Localizer["Cancel"]</button>
        </div>
    </div>
</div>

<CalendarPopup IsOpen="@(ViewModel.ShowCalendarPopup)"
                InitialDate="ViewModel.CalendarDate"
                OnConfirm="OnCalendarPopUpTaskDateConfirmed"
                OnCancel="ViewModel.CloseCalendarPopup" />

<TimeInputDialogPopUp IsOpen="_showTimeInputDialog"
                      InitialMinutes="_timeInputInitialMinutes"
                      Title="@_timeInputTitle"
                      OnConfirm="OnTimerInputConfirmed"
                      OnCancel="CloseTimeInputDialog" />

<TemplateListPopUp IsOpen="_showTemplateListPopup"
                          Options="ViewModel.TemplateOptions"
                          OnCopy="CopyTemplateAsync"
                          OnEdit="EditTemplateAsync"
                          OnCancel="CloseTemplateListPopup" />

<TaskSchedulePopUp IsOpen="_showSchedulePopup"
                   Model="_scheduleModel"
                   TaskDate="ViewModel.CalendarDate"
                   CanRepeat="ViewModel.CanRepeat"
                   OnConfirm="ConfirmSchedule"
                   OnCancel="CloseSchedulePopup" />
}

@code {
    private readonly string _taskNoteInputId = $"task-note";
    private readonly string _taskTemplateFlagInputId = $"task-templateFlag";
    private readonly string _prioritySliderInputId = $"task-priority";
    private readonly string _dialogTitleId = $"task-edit-title";

    private const int PositivityHighlightMilliseconds = 900;

    private bool _showTemplateListPopup;
    private bool _highlightPositivityButtons;
    private bool _showSchedulePopup;
    private TaskScheduleModel? _scheduleModel;
    private bool _showTimeInputDialog;
    private bool _initializedForOpenCycle;
    private bool _focusDialogAfterRender;
    private int _timeInputInitialMinutes;
    private string? _timeInputTitle;
    private TimerType _activeTimerType = TimerType.FocusTimer;
    private ElementReference _dialogElement;
    private IDisposable? _backPressRegistration;

    [Parameter]
    public TaskEditPopUpInputModel? Model { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<TaskEditPopUpClosePayload> OnClose { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Observe(ViewModel);
        _backPressRegistration = UiBackPressService.RegisterHandler(HandleBackPressed);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!IsOpen)
        {
            _initializedForOpenCycle = false;
            ResetLocalPopupState();

            return;
        }

        if (!_initializedForOpenCycle)
        {
            ViewModel.Open(Model);
            ResetLocalPopupState();
            _initializedForOpenCycle = true;
            _focusDialogAfterRender = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!IsOpen || !_focusDialogAfterRender)
        {
            return;
        }

        _focusDialogAfterRender = false;
        await _dialogElement.FocusAsync();
    }

    private void OnTemplateFlagChanged(ChangeEventArgs args)
    {
        bool.TryParse(args.Value?.ToString(), out var parsed);
        ViewModel.SetTemplateFlag(parsed);
    }

    private void OnPrioritySliderInput(ChangeEventArgs args)
    {
        int.TryParse(args.Value?.ToString(), out var sliderValue);
        ViewModel.SetPriorityIndex(sliderValue);
    }

    private void OpenTaskDatePopup()
    {
        ViewModel.RequestOpeningCalendarPopUp();
    }

    private void OpenTemplateListPopup()
    {
        if ( ViewModel.HasTemplateOptions)
            _showTemplateListPopup = true;
    }

    private string PositivityHighlightCssClass => _highlightPositivityButtons ? "highlight" : string.Empty;

    private async Task HighlightPositivityButtonsIfDisabled()
    {
        if (ViewModel.HasSelectedTaskPositivity || _highlightPositivityButtons)
        {
            return;
        }

        _highlightPositivityButtons = true;
        await Task.Delay(PositivityHighlightMilliseconds);
        _highlightPositivityButtons = false;
    }

    private void OpenSchedulePopup()
    {
        _scheduleModel = ViewModel.CreateScheduleModel();
        _showSchedulePopup = true;
    }

    private void CloseSchedulePopup()
    {
        _showSchedulePopup = false;
    }

    private void ConfirmSchedule(TaskScheduleModel schedule)
    {
        ViewModel.ApplySchedule(schedule);
        _showSchedulePopup = false;
    }

    private void OpenTimerInputDialog(TimerType timerType)
    {
        _activeTimerType = timerType;
        _timeInputInitialMinutes = ViewModel.GetTimerMinutes(timerType);
        _timeInputTitle = GetTimerInputTitle(timerType);
        _showTimeInputDialog = true;
    }

    private void OnTimerInputConfirmed(int minutes)
    {
        ViewModel.SetTimerMinutes(_activeTimerType, minutes);
        _showTimeInputDialog = false;
    }

    private void CloseTemplateListPopup()
    {
        _showTemplateListPopup = false;
    }

    private Task CopyTemplateAsync(Guid taskId)
        => CloseAsync(TaskEditPopUpCloseAction.CopyTemplate, taskId);

    private Task EditTemplateAsync(Guid taskId)
        => CloseAsync(TaskEditPopUpCloseAction.EditTemplate, taskId);

    private async Task HandleSaveAsync()
    {
        await CloseAsync(TaskEditPopUpCloseAction.Save, templateTaskId:null);
    }

    private async Task HandleCancelAsync()
    {
        await CloseAsync(TaskEditPopUpCloseAction.Cancel, templateTaskId:null);
    }

    private async Task CloseAsync(TaskEditPopUpCloseAction action, Guid? templateTaskId )
    {
        var payload = ViewModel.CreateClosePayload(action, templateTaskId);
        ViewModel.Close();
        await OnClose.InvokeAsync(payload);

        ResetLocalPopupState();

    }

    private void CloseTimeInputDialog()
    {
        _showTimeInputDialog = false;
    }

    private async Task HandleModalKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape")
        {
            return;
        }

        await CloseTopmostAsync();
    }

    private bool HandleBackPressed()
    {
        if (!IsOpen)
        {
            return false;
        }

        _ = InvokeAsync(async () =>
        {
            await CloseTopmostAsync();
            StateHasChanged();
        });

        return true;
    }

    private async Task CloseTopmostAsync()
    {
        if (_showTimeInputDialog)
        {
            CloseTimeInputDialog();
            return;
        }

        if (_showSchedulePopup)
        {
            CloseSchedulePopup();
            return;
        }

        if (_showTemplateListPopup)
        {
            CloseTemplateListPopup();
            return;
        }

        if (ViewModel.ShowCalendarPopup)
        {
            ViewModel.CloseCalendarPopup();
            return;
        }

        await HandleCancelAsync();
    }

    private void OnCalendarPopUpTaskDateConfirmed(DateTime selectedDate)
    {
        ViewModel.SetDate(selectedDate);
    }

    private string GetTimerInputTitle(TimerType timerType) => timerType switch
    {
        TimerType.FocusTimer => Localizer["SetFocusTime"],
        TimerType.BreakTimer => Localizer["SetBreakTime"],
        _ => Localizer["SetTimer"]
    };

    private void ResetLocalPopupState()
    {
        _showTemplateListPopup = false;
        _showSchedulePopup = false;
        _showTimeInputDialog = false;
        _highlightPositivityButtons = false;
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            _backPressRegistration?.Dispose();
        }

        base.Dispose(disposing);
    }
}
