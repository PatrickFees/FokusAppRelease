@page "/errors"
@page "/fehler"
@implements IDisposable
@inject FokusApp.Components.ErrorComponent.IErrorPageViewModel ViewModel

<PageTitle>@Localizer["Errors"]</PageTitle>

<div class="errors-page">
    <header class="errors-header">
        <h1>@Localizer["Errors"]</h1>
        <button type="button" class="errors-refresh-button" @onclick="ReloadAsync">@Localizer["Refresh"]</button>
    </header>
    @if (_isInitialized)
    {
        @if (!string.IsNullOrEmpty(ViewModel.LoadErrorMessage))
        {
            <p class="errors-status">@ViewModel.LoadErrorMessage</p>
        }

       @if (!ViewModel.Items.Any())
        {
            <p class="errors-status">@Localizer["NoSavedErrors"]</p>
        }

        <div class="errors-list">

        @foreach (var item in ViewModel.Items)
        {
            <article class="error-card">
                <header class="error-card-header">
                    <div class="error-card-title-group">
                        <h2>@item.Title</h2>
                        <span class="error-card-flags">
                            @if (item.IsFatal)
                            {
                                <span class="flag fatal">Fatal</span>
                            }
                            @if (item.IsUiFailure)
                            {
                                <span class="flag ui">UI</span>
                            }
                        </span>
                    </div>

                    <div class="error-card-actions">
                        <button type="button" class="error-action-button" @onclick="() => CopyAsync(item.ErrorText)">@Localizer["Copy"]</button>
                        @if (!_isWindows)
                        {
                            <button type="button" class="error-action-button" @onclick="() => ShareAsync(item.ErrorText)">@Localizer["Share"]</button>
                        }
                    </div>
                </header>

                <textarea class="error-text-field" readonly>@item.ErrorText</textarea>
            </article>
        }
    </div>
    }
    
</div>

@code {

    private bool _isWindows => DeviceInfo.Current.Platform == DevicePlatform.WinUI;
    private bool _isInitialized;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        ViewModel.PropertyChanged += OnViewModelChanged;
        await ViewModel.InitializeAsync();
        _isInitialized = true;
    }

    private Task ReloadAsync() => ViewModel.ReloadAsync();

    private async Task CopyAsync(string errorText)
    {
        var normalizedText = errorText?.Trim() ?? string.Empty;
        await Clipboard.Default.SetTextAsync(normalizedText); 
    }

    private async Task ShareAsync(string errorText)
    {
        var request = new ShareTextRequest
        {
            Title = Localizer["ShareError"],
            Text = errorText ?? string.Empty
        };

        await Share.Default.RequestAsync(request);
    }

    private void OnViewModelChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelChanged;
    }
}
