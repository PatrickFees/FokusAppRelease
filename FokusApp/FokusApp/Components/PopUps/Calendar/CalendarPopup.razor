@using FokusApp.Components.PopUps.Calendar
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@inherits ObservableComponentBase
@inject ICalendarPopupViewModel ViewModel

@if (IsOpen)
{
    <div class="calendar-popup-backdrop popup-overlay">
        <div class="calendar-popup-shell"
             role="dialog"
             aria-modal="true"
             @onpointerdown="HandlePointerDown"
             @onpointerup="HandlePointerUp"
             @onpointerleave="ResetSwipeTracking"
             @onpointercancel="ResetSwipeTracking">
            <header class="calendar-popup-header">
                <button type="button"
                        class="month-nav-button"
                        @onclick="ViewModel.GoToPreviousMonth"
                        aria-label="@Localizer["PreviousMonth"]">
                    &#x2039;
                </button>
                <h2>@ViewModel.CurrentMonth.MonthStart.ToString("Y", CultureInfo.CurrentCulture)</h2>
                <button type="button"
                        class="month-nav-button"
                        @onclick="ViewModel.GoToNextMonth"
                        aria-label="@Localizer["NextMonth"]">
                    &#x203A;
                </button>
            </header>

            <section class="calendar-popup-content">
                <div class="weekday-header-row">
                    @foreach (var weekday in WeekdayHeaders)
                    {
                        <span class="weekday-header-cell">@weekday</span>
                    }
                </div>

                <div class="calendar-day-grid">
                    @foreach (var day in ViewModel.CurrentMonth.DayCells)
                    {
                        <button type="button"
                                class="@BuildDayButtonCss(day)"
                                @onclick="() => ViewModel.SelectDate(day.Date)">
                            @day.Date.Day
                        </button>
                    }
                </div>
            </section>

            <footer class="calendar-popup-actions">
                <button type="button" class="btn btn-secondary" @onclick="HandleCancel">@Localizer["Cancel"]</button>
                <button type="button" class="btn btn-primary" @onclick="HandleConfirm">OK</button>
            </footer>
        </div>
    </div>
}

@code {
    private double? _swipeStartX;
    private bool _initializedForOpenCycle;

    private static IReadOnlyList<string> WeekdayHeaders
    {
        get
        {
            var headers = CultureInfo.CurrentCulture.DateTimeFormat.AbbreviatedDayNames;
            return [headers[1], headers[2], headers[3], headers[4], headers[5], headers[6], headers[0]];
        }
    }

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public DateTime InitialDate { get; set; }

    [Parameter]
    public EventCallback<DateTime> OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Observe(ViewModel);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!IsOpen)
        {
            _initializedForOpenCycle = false;
            return;
        }

        if (!_initializedForOpenCycle)
        {
            ViewModel.Open(InitialDate.Date);
            _initializedForOpenCycle = true;
        }
    }

    private async Task HandleConfirm()
    {
        await OnConfirm.InvokeAsync(ViewModel.SelectedDate);
      
    }

    private async Task HandleCancel()
    {
        await OnCancel.InvokeAsync();

    }

    private void HandlePointerDown(PointerEventArgs args)
    {
        _swipeStartX = args.ClientX;
    }

    private void HandlePointerUp(PointerEventArgs args)
    {
        if (!_swipeStartX.HasValue)
        {
            return;
        }

        var swipeDelta = args.ClientX - _swipeStartX.Value;
        ViewModel.HandleHorizontalSwipe(swipeDelta);
        _swipeStartX = null;
    }

    private void ResetSwipeTracking()
    {
        _swipeStartX = null;
    }

    private static string BuildDayButtonCss(CalendarDayCellModel day)
    {
        var classes = "calendar-day-button";

        if (!day.IsInCurrentMonth)
        {
            classes += " outside-month";
        }

        if (day.IsToday)
        {
            classes += " is-today";
        }

        if (day.IsSelected)
        {
            classes += " is-selected";
        }

        return classes;
    }

}
