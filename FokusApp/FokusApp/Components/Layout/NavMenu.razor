@implements IAsyncDisposable
@inject Layout.INavMenuViewModel ViewModel
@inject IJSRuntime JS

<div class="nav-root">
    <div class="top-row ps-3 navbar navbar-dark">
        <div class="container-fluid top-row-content">
            <div class="scope-switcher" role="group" aria-label="@Localizer["TaskFocus"]">
                <span class="scope-label @(ViewModel.IsWorkScope ? "active" : "inactive")">@Localizer["Work"]</span>
                <button type="button"
                        class="scope-toggle"
                        role="switch"
                        aria-label="@Localizer["ToggleScope"]"
                        aria-checked="@(ViewModel.IsWorkScope ? "true" : "false")"
                        @onclick="ToggleTaskScope">
                    <span class="scope-toggle-thumb @(ViewModel.IsWorkScope ? "is-work" : "is-private")"></span>
                </button>
                <span class="scope-label @(ViewModel.IsWorkScope ? "inactive" : "active")">@Localizer["Private"]</span>
            </div>

            <button type="button"
                    @ref="_menuButton"
                    title="@Localizer["NavigationMenu"]"
                    aria-label="@Localizer["NavigationMenu"]"
                    aria-haspopup="true"
                    aria-expanded="@(ViewModel.IsNavigationExpanded ? "true" : "false")"
                    class="navbar-toggler @(ViewModel.IsNavigationExpanded ? "expanded" : string.Empty)"
                    @onclick="ToggleNavigationMenu">
            </button>
        </div>
    </div>

    @if (ViewModel.IsNavigationExpanded)
    {
        <div class="nav-backdrop" @onclick="CollapseNavigationMenu"></div>
        <nav class="nav-fan" aria-label="@Localizer["NavigationMenu"]">
            @foreach (var item in _items)
            {
                <button type="button"
                        class="nav-fan-item @(IsCurrent(item) ? "current" : string.Empty)"
                        data-nav-route="@item.Route"
                        aria-current="@(IsCurrent(item) ? "page" : null)"
                        @onclick="() => NavigateTo(item.Route)">
                    @Localizer[item.TextKey]
                </button>
            }
        </nav>
    }
</div>

@code
{
    private sealed record NavItem(string TextKey, string Route, string[] Aliases);

    private readonly NavItem[] _items =
    [
        new("NavTimer", "/focus-timer", ["/focus-timer"]),
        new("NavCalendar", "/", ["/", "/calender"]),
        new("NavManagement", "/aufgaben", ["/aufgaben"]),
        new("Settings", "/einstellungen", ["/einstellungen", "/settings"]),
        new("Errors", "/errors", ["/errors", "/fehler"])
    ];

    private ElementReference _menuButton;
    private IJSObjectReference? _module;
    private IJSObjectReference? _attachment;
    private DotNetObjectReference<NavMenu>? _selfReference;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _selfReference = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/navFan.js");
        _attachment = await _module.InvokeAsync<IJSObjectReference>("attach", _menuButton, _selfReference);
    }

    private bool IsCurrent(NavItem item)
    {
        return item.Aliases.Contains(ViewModel.CurrentRoute, StringComparer.Ordinal);
    }

    private void ToggleTaskScope()
    {
        ViewModel.ToggleTaskScopeCommand.Execute(null);
    }

    private void ToggleNavigationMenu()
    {
        ViewModel.ToggleNavigationMenuCommand.Execute(null);
    }

    private void CollapseNavigationMenu()
    {
        ViewModel.CollapseNavigationMenuCommand.Execute(null);
    }

    private void NavigateTo(string route)
    {
        ViewModel.NavigateToCommand.Execute(route);
    }

    [JSInvokable]
    public void OnHoldStarted()
    {
        ViewModel.ExpandNavigationMenuCommand.Execute(null);
    }

    [JSInvokable]
    public void OnHoldReleased(string? route)
    {
        ViewModel.NavigateToCommand.Execute(route);
    }

    private void OnViewModelPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }


    public async ValueTask DisposeAsync()
    {
        ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
        _selfReference?.Dispose();

        try
        {
            if (_attachment is not null)
            {
                await _attachment.InvokeVoidAsync("dispose");
                await _attachment.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
