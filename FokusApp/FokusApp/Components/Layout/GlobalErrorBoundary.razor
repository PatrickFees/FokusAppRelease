@inherits ErrorBoundary
@implements IDisposable
@inject NavigationManager NavigationManager
@inject FokusApp.Core.Services.Interfaces.IAppErrorCaptureService ErrorCaptureService

@if (CurrentException is null)
{
    @ChildContent
}
else
{
    <section class="global-error-boundary" role="alert" aria-live="assertive">
        <h1>@Localizer["UnexpectedErrorTitle"]</h1>
        <p>@Localizer["UnexpectedErrorDescription"]</p>
        <button type="button" class="global-error-recover-button" @onclick="RecoverView">@Localizer["ReloadView"]</button>
    </section>
}

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override Task OnErrorAsync(Exception exception)
    {
        return ErrorCaptureService.CaptureAsync(
            exception,
            new FokusApp.Core.Services.AppErrorCaptureOptions
            {
                Source = "Blazor.GlobalErrorBoundary",
                IsFatal = false,
                IsUiFailure = true,
                Route = NormalizeCurrentRoute()
            });
    }

    private void RecoverView()
    {
        Recover();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        Recover();
    }

    private string NormalizeCurrentRoute()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim();
        if (string.IsNullOrWhiteSpace(relativePath))
        {
            return "/";
        }

        if (relativePath.StartsWith('/'))
        {
            return relativePath;
        }

        return $"/{relativePath}";
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
