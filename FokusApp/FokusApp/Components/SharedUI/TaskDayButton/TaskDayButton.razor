@using FokusApp.Components.SharedUI.FilterComponent

<button type="button"
        class="task-day-button"
        disabled="@(!Model.IsEnabled)"
        @onclick="HandleClick">
    @Model.Text
</button>

@code {
    [Parameter, EditorRequired]
    public TaskDayButtonModel Model { get; set; } = new();

    [Parameter]
    public EventCallback OnClick { get; set; }

    private Task HandleClick()
    {
        if (!Model.IsEnabled)
        {
            return Task.CompletedTask;
        }

        return OnClick.InvokeAsync();
    }
}
