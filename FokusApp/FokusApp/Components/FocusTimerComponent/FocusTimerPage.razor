@page "/focus-timer"
@inherits ObservableComponentBase
@inject FokusApp.Components.FocusTimerComponent.IFocusTimerViewModel ViewModel
@inject FokusApp.Services.IUiBackPressService UiBackPressService

@using System
@using System.Globalization
@using System.Threading.Tasks
@using FokusApp.Components.SharedUI
@using FokusApp.Components.SharedUI.FilterComponent
@using FokusApp.Components.PopUps.TimeInputDialog
@using FokusApp.Core.Enums
@using FokusApp.Core.Services
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web

<PageTitle>@Localizer["FocusTimer"]</PageTitle>

<div class="focus-timer">
    @if (!ViewModel.IsBreakMode)
    {
        <section class="timer-task-panel">
            <label class="timer-task-label" for="timer-task-picker-trigger">@Localizer["SelectTask"]</label>
            <div class="timer-task-picker" @onclick:stopPropagation="true">
                <button id="timer-task-picker-trigger"
                        type="button"
                        class="timer-task-picker-trigger @(_isTaskPickerOpen ? "open" : string.Empty)"
                        aria-expanded="@_isTaskPickerOpen"
                        aria-haspopup="dialog"
                        @onclick="ToggleTaskPicker">
                    <span class="timer-task-picker-trigger-label">@(_isTaskPickerOpen ? Localizer["HideFilters"] : Localizer["ShowFilters"])</span>
                    <span class="timer-task-picker-trigger-icon" aria-hidden="true">&#x25BE;</span>
                </button>

                @if (_isTaskPickerOpen)
                {

                    <button type="button"
                            class="timer-task-picker-backdrop"
                            aria-label="@Localizer["CloseTaskPopup"]"
                            @onclick="CloseTaskPicker">
                    </button>

                    <div class="timer-task-picker-popup"
                         role="dialog"
                         aria-label="@Localizer["SelectTask"]"
                         @onclick:stopPropagation="true">
                        <FilterComponent IsOpen="true"
                                         ShowDateSortToggle="false"
                                         ResetFiltersOnOpen="false"
                                         InitialSearchText="@ViewModel.TaskFilter.SearchText"
                                         InitialSelectedPriorities="ViewModel.TaskFilter.SelectedPriorities"
                                         InitialIsSortDescending="ViewModel.TaskFilter.IsSortDescending"
                                         InitialSelectedDate="ViewModel.TaskFilter.SelectedDate"
                                         OnFiltersChanged="ViewModel.ApplyFilterChangesAsync" />

                        <div class="timer-task-picker-list" role="listbox" aria-label="@Localizer["SelectTask"]">
                            <button type="button"
                                    role="option"
                                    aria-selected="@(ViewModel.SelectedTaskId is null)"
                                    class="timer-task-option timer-task-option-no-task @(ViewModel.SelectedTaskId is null ? "selected" : string.Empty)"
                                    @onclick="() => SelectTaskAndCloseAsync(null)">
                                @Localizer["NoTask"]
                            </button>

                            @if (ViewModel.NormalTasks.Count == 0 && ViewModel.RegularTasks.Count == 0)
                            {
                                <p class="timer-task-no-results">@Localizer["NoTasksForFilters"]</p>
                            }
                            else
                            {
                                @if (ViewModel.NormalTasks.Count > 0)
                                {
                                    <section class="timer-task-group" role="group" aria-labelledby="timer-normal-task-heading">
                                        <h3 id="timer-normal-task-heading" class="timer-task-group-heading">@Localizer["OneTimeTasks"]</h3>
                                        @foreach (var task in ViewModel.NormalTasks)
                                        {
                                            <button type="button"
                                                    role="option"
                                                    aria-selected="@(ViewModel.SelectedTaskId == task.Id)"
                                                    class="timer-task-option @(ViewModel.SelectedTaskId == task.Id ? "selected" : string.Empty)"
                                                    @onclick="() => SelectTaskAndCloseAsync(task.Id)">
                                                @(task.Note ?? string.Empty)
                                            </button>
                                        }
                                    </section>
                                }

                                @if (ViewModel.RegularTasks.Count > 0)
                                {
                                    <section class="timer-task-group" role="group" aria-labelledby="timer-regular-task-heading">
                                        <h3 id="timer-regular-task-heading" class="timer-task-group-heading">@Localizer["RegularTasks"]</h3>
                                        @foreach (var task in ViewModel.RegularTasks)
                                        {
                                            <button type="button"
                                                    role="option"
                                                    aria-selected="@(ViewModel.SelectedTaskId == task.Id)"
                                                    class="timer-task-option @(ViewModel.SelectedTaskId == task.Id ? "selected" : string.Empty)"
                                                    @onclick="() => SelectTaskAndCloseAsync(task.Id)">
                                                @(task.Note ?? string.Empty)
                                            </button>
                                        }
                                    </section>
                                }
                            }
                        </div>
                    </div>
                }
            </div>

            @if (!ViewModel.HasAvailableTasks)
            {
                <p class="timer-task-empty">@Localizer["NoOpenTasks"]</p>
            }

            @if (!string.IsNullOrWhiteSpace(ViewModel.SelectedTask.Note))
            {
                <p class="timer-task-details">
                    <span class="timer-task-priority priority-label @(PriorityFormatter.GetCssClass(ViewModel.SelectedTaskPriority))">@Localizer["Priority", PriorityFormatter.Format(ViewModel.SelectedTaskPriority)]</span>
                    <span class="timer-task-note">@ViewModel.SelectedTaskNote</span>
                </p>
            }
        </section>
    }
    else
    {
        <section class="timer-break-panel">
            <h2 class="timer-break-title">@Localizer["Break"]</h2>
        </section>
    }

    <div class="timer-clock"
         @onpointerdown="OnTimerPointerDown"
         @onpointerdown:preventDefault
         @onpointermove="OnTimerPointerMove"
         @onpointermove:preventDefault
         @onpointerup="StopTimerRingDrag"
         @onpointercancel="StopTimerRingDrag"
         @onpointerleave="StopTimerRingDrag">
        <svg class="timer-svg" viewBox="0 0 260 260">
            <circle class="timer-ring-base" cx="130" cy="130" r="118" />
            <circle class="timer-ring-selection" cx="130" cy="130" r="118" style="@_selectionStrokeStyle" transform="rotate(-90 130 130)" />
            <circle class="timer-ring-progress" cx="130" cy="130" r="95" style="@_progressStrokeStyle" transform="rotate(-90 130 130)" />
        </svg>

        <div class="timer-display"
             role="button"
             tabindex="0"
             @onclick="OpenManualInputDialog"
             @onclick:stopPropagation
             @onpointerdown:stopPropagation
             @onkeydown="HandleTimerDisplayKeyDown">
            <span class="timer-display-time">@ViewModel.FormattedTime</span>
            <span class="timer-display-minutes">@ViewModel.InputMinutes<span class="timer-display-minutes-unit"> @Localizer["MinutesShort"]</span></span>
        </div>
    </div>

    <p class="timer-hint">@Localizer["TimerHint"]</p>
    @if (ViewModel.IsNotificationPermissionMissing)
    {
        <p class="timer-permission-hint">@Localizer["NotificationPermissionHint"]</p>
    }

    <div class="timer-actions">
        <button class="btn btn-primary timer-toggle-button @(ViewModel.IsRunning ? "is-running" : string.Empty)"
                @onclick="@ViewModel.SwitchTimerToStartOrStop"
                disabled="@(!ViewModel.CanToggleTimer)">@(ViewModel.IsRunning ? Localizer["Break"] : Localizer["Start"])</button>
        <button class="btn btn-secondary"
                @onclick="@ViewModel.ResetTimer"
                disabled="@(!ViewModel.CanResetTimer)">@(ViewModel.IsBreakMode ? Localizer["EndBreak"] : Localizer["Reset"])</button>
    </div>

    <TimeInputDialogPopUp IsOpen="_showManualInputDialog"
                          InitialMinutes="ViewModel.InputMinutes"
                          Title="@Localizer["SetTimer"]"
                          OnConfirm="HandleManualInputConfirmed"
                          OnCancel="CloseManualInputDialog" />
</div>

@code {
    private bool _isTaskPickerOpen;
    private bool _isTimerRingDragActive;
    private bool _showManualInputDialog;

    private IDisposable? _backPressRegistration;
    private string _selectionStrokeStyle => GetStrokeStyle(
        TimerDialCalculator.OuterRingCircumference,
        TimerDialCalculator.GetSelectionStrokeOffset(ViewModel.SelectedMinuteRatio));

    private string _progressStrokeStyle => GetStrokeStyle(
        TimerDialCalculator.ProgressRingCircumference,
        TimerDialCalculator.GetProgressStrokeOffset(ViewModel.CountdownProgress));

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _backPressRegistration = UiBackPressService.RegisterHandler(HandleBackPressed);
        Observe(ViewModel);
        await ViewModel.InitializeAsync();
    }

    private void OpenManualInputDialog()
    {
        _showManualInputDialog = ViewModel.IsTimerActive ? false : true;
    }

    private void HandleManualInputConfirmed(int minutes)
    {
        ViewModel.SetMinutes(minutes);
        _showManualInputDialog = false;
    }

    private void CloseManualInputDialog()
    {
        _showManualInputDialog = false;
    }

    private void ToggleTaskPicker()
    {
        if (_isTaskPickerOpen)
        {
            CloseTaskPicker();
            return;
        }

        ViewModel.PrepareTaskPicker();
        _isTaskPickerOpen = true;
    }

    private void CloseTaskPicker()
    {
        _isTaskPickerOpen = false;
    }

    private async Task SelectTaskAndCloseAsync(Guid? taskId)
    {
        await ViewModel.SelectTaskAsync(taskId);
        CloseTaskPicker();
    }

    private void HandleTimerDisplayKeyDown(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or " " or "Spacebar")
        {
            OpenManualInputDialog();
        }
    }

    private void OnTimerPointerDown(PointerEventArgs args)
    {
        if (ViewModel.IsTimerActive)
        {
            StopTimerRingDrag();
            return;
        }

        SetMinutesFromTimerPointer(args);
    }

    private void OnTimerPointerMove(PointerEventArgs args)
    {
        if (!_isTimerRingDragActive)
        {
            return;
        }

        SetMinutesFromTimerPointer(args);
    }

    private void SetMinutesFromTimerPointer(PointerEventArgs args)
    {
        if (TimerDialCalculator.IsPointerWithinAdjustmentRing(args.OffsetX, args.OffsetY))
        {
            var minutes = TimerDialCalculator.CalculateMinutesFromPointer(args.OffsetX, args.OffsetY);
            ViewModel.SetMinutes(minutes);
            _isTimerRingDragActive = true;
        }
        else
        {
            StopTimerRingDrag();
        }
    }

    private void StopTimerRingDrag()
    {
        _isTimerRingDragActive = false;
    }

    private static string GetStrokeStyle(double circumference, double strokeOffset)
    {
        return $"stroke-dasharray: {circumference.ToString("F2", CultureInfo.InvariantCulture)}; stroke-dashoffset: {strokeOffset.ToString("F2", CultureInfo.InvariantCulture)};";
    }

    private bool HandleBackPressed()
    {
        if (!_isTaskPickerOpen)
        {
            return false;
        }

        CloseTaskPicker();
        _ = InvokeAsync(StateHasChanged);
        return true;
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing)
        {
            _backPressRegistration?.Dispose();
        }

        base.Dispose(disposing);
    }
}
