@page "/aufgaben"
@inherits ObservableComponentBase
@inject FokusApp.Components.TaskOverViewComponent.ITaskOverViewViewModel ViewModel

@using FokusApp.Components.PopUps.TaskEdit
@using FokusApp.Components.SharedUI
@using FokusApp.Components.SharedUI.FilterComponent

<PageTitle>@Localizer["Tasks"]</PageTitle>

<div class="task-page">
    <header class="task-header">
        <h1>@Localizer["Tasks"]</h1>
        <button class="btn btn-primary" @onclick="ViewModel.OpenAddNoteModal">@Localizer["AddTask"]</button>
    </header>

    <p class="task-intro">
        @Localizer["TaskOverviewIntro"]
    </p>

    <section class="task-filter-section">
        <button type="button" class="task-filter-toggle" @onclick="ViewModel.ToggleFilterPanel">
            @(ViewModel.IsFilterPanelOpen ? Localizer["HideFilters"] : Localizer["ShowFilters"])
        </button>

        @if (ViewModel.IsFilterPanelOpen)
        {
            <button type="button"
                    class="task-filter-backdrop"
                    aria-label="@Localizer["CloseFilters"]"
                    @onclick="ViewModel.CloseFilterPanel">
            </button>

            <div class="task-filter-content" @onclick:stopPropagation="true">
                <FilterComponent IsOpen="true"
                                 ResetFiltersOnOpen="false"
                                 ShowDateSortToggle="true"
                                 InitialSearchText="@ViewModel.Filter.SearchText"
                                 InitialSelectedPriorities="ViewModel.Filter.SelectedPriorities"
                                 InitialIsSortDescending="ViewModel.Filter.IsSortDescending"
                                 InitialSelectedDate="ViewModel.Filter.SelectedDate"
                                 OnFiltersChanged="ViewModel.ApplyOverviewFilters" />
            </div>
        }
    </section>

    <section class="task-section">
        <h2>@Localizer["ActiveTasks"]</h2>
        <ul class="task-list">
            @foreach (var task in ViewModel.ActiveTasks)
            {
                <TaskListItem @key="task.Id"
                              Task="task"
                              ListType="TaskListItem.TaskListItemType.Active"
                              IsRunning="@ViewModel.IsTaskActive(task.Id)"
                              OnEdit="ViewModel.StartEditTask"
                              OnDelete="ViewModel.DeleteTaskAsync" />
            }
        </ul>
    </section>

    <section class="task-section">
        <h2>@Localizer["RegularTasksCount", ViewModel.RegularTasks.Count]</h2>
        <ul class="task-list">
            @foreach (var task in ViewModel.RegularTasks)
            {
                <TaskListItem @key="task.Id"
                              Task="task"
                              ListType="TaskListItem.TaskListItemType.Regular"
                              IsRunning="@ViewModel.IsTaskActive(task.Id)"
                              OnEdit="ViewModel.StartEditTask"
                              OnDelete="ViewModel.DeleteTaskAsync" />
            }
        </ul>
    </section>

    <section class="task-section">
        <details open>
            <summary>@Localizer["CompletedTasksCount", ViewModel.CompletedTasks.Count]</summary>
            <ul class="task-list completed">
                @foreach (var task in ViewModel.CompletedTasks)
                {
                    <TaskListItem @key="task.Id"
                                  Task="task"
                                  ListType="TaskListItem.TaskListItemType.Completed"
                                  IsRunning="@ViewModel.IsTaskActive(task.Id)"
                                  OnEdit="ViewModel.StartEditTask"
                                  OnDelete="ViewModel.DeleteTaskAsync" />
                }
            </ul>
        </details>
    </section>

    <TaskEditPopUp @key="ViewModel.TaskEditorInput"
                   IsOpen="ViewModel.IsAddNoteModalOpen"
                   Model="ViewModel.TaskEditorInput"
                   OnClose="ViewModel.HandleTaskEditPopupCloseAsync" />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        Observe(ViewModel);
        await ViewModel.InitializeAsync();
    }
}
